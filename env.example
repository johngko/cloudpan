# CloudPan 运行配置模板
# 复制为 env.local 使用（Linux/macOS 可直接运行 ./start.sh install，向导会自动生成本文件）。
# env.local 含数据库密码等敏感信息，已被 .gitignore 排除，绝不提交。
# Windows 用户：把需要的项配置成系统环境变量（变量名相同），或用 start.sh（WSL/Git Bash）走安装向导。

# ---- 基础 ----
# 服务监听端口
CP_PORT=18322
# 数据目录（上传的文件、回收站、缩略图、上传临时区、secret.key 都在这里，请定期备份）
CP_DATA=./server/data
# 对外可达地址（反向代理后的 https 地址；ONLYOFFICE 集成与云盘扫码回调需要）
CP_PUBLIC_URL=
# 反向代理网段（逗号分隔 CIDR/IP，如 127.0.0.1,10.0.0.0/8；留空=不信任任何 X-Forwarded-For）
CP_TRUSTED_PROXIES=

# ---- 数据库 ----
# sqlite（零依赖，默认） 或 mysql（外部数据库，适合长期/多用户部署）
CP_DB=sqlite
# CP_DB=mysql 时生效：
CP_MYSQL_HOST=127.0.0.1
CP_MYSQL_PORT=3306
CP_MYSQL_USER=
CP_MYSQL_PASSWORD=
CP_MYSQL_NAME=cloudpan
# 完整 DSN（可选，提供时覆盖上面的 MySQL 单项）
CP_MYSQL_DSN=

# ---- 管理员账号（仅首次部署/一键初始化建号时生效；存量系统用 ./start.sh admin 修改） ----
# 用户名：2-32 位，字母/数字/下划线/短横线；留空默认 admin
CP_ADMIN_USER=admin
# 密码：至少 8 位；留空则随机生成并只在启动日志打印一次
CP_ADMIN_PASSWORD=

# 文件事件 Webhook 允许内网/回环目标（同局域网 n8n/HomeAssistant）；默认关，云元数据段(169.254/16)始终拒绝
CP_WEBHOOK_ALLOW_PRIVATE=
