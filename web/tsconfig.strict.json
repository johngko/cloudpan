{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"]
  },
  "include": ["src/api/**/*.ts", "src/stores/**/*.ts", "src/apps/explorer/**/*.ts", "src/apps/admin/**/*.ts", "src/test/**/*.ts"]
}