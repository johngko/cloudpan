{
  "name": "CloudPan 云盘",
  "short_name": "CloudPan",
  "description": "自托管网盘与 Web 云桌面",
  "start_url": "/#/desktop",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1f2430",
  "theme_color": "#2473DC",
  "icons": [
    {
      "src": "/icons/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/pwa/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": {
            "image/*": [".jpg", ".jpeg", ".png", ".webp", ".gif", ".heic", ".heif", ".bmp"],
            "video/*": [".mp4", ".webm", ".mov", ".mkv", ".avi"]
          }
        },
        {
          "name": "files",
          "accept": {
            "text/plain": [".txt", ".md", ".csv", ".log"]
          }
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "上传文件",
      "url": "/#/desktop?app=explorer"
    }
  ]
}
